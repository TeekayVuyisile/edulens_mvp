# Copy to .env and fill in. Never commit .env.

# Server
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:5173

# Database: local Postgres via DB_*, or a single DATABASE_URL (e.g. Neon).
# DATABASE_URL takes precedence when set. Neon URLs include ?sslmode=require.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=edulens_lms
DB_USER=postgres
DB_PASSWORD=
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
# DB_SSL=true

# Tests create and drop this database (must end in _test). Defaults to edulens_lms_test.
# TEST_DB_NAME=edulens_lms_test

# Initial super admin created by `npm run migrate`. Required in production;
# development falls back to superadmin@edulens.com / Admin123!
# SUPER_ADMIN_EMAIL=
# SUPER_ADMIN_PASSWORD=

# Auth
JWT_SECRET=change-me
JWT_EXPIRE=7d

# Email (password reset)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
FROM_EMAIL=
FROM_NAME=Edulens LMS

# AI worksheet generation. Use Groq (free tier: https://console.groq.com/keys) or OpenAI.
# Without AI_PROVIDER, Groq is used when GROQ_API_KEY is set. Teachers see "not set up" until a real key is present.
AI_PROVIDER=groq
GROQ_API_KEY=
# Optional: any Groq chat model (default openai/gpt-oss-20b, with fallbacks if it's unavailable).
# AI_STRUCTURED_OUTPUT=true/false overrides whether strict JSON schemas are used.
GROQ_MODEL=
AI_STRUCTURED_OUTPUT=
# OpenAI instead: AI_PROVIDER=openai and an sk-... key (default model gpt-4o-mini)
OPENAI_API_KEY=
OPENAI_MODEL=
# Generations per teacher per 24 hours
WORKSHEET_DAILY_LIMIT=30

# Demo school (npm run seed:demo). DEMO_LOGIN=true adds one-click "sign in as" buttons for the
# demo accounts to the login page, with no password. Only turn it on for a public demo.
SEED_DEMO=
DEMO_LOGIN=

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
