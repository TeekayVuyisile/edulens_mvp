# Copy to .env and fill in. Never commit .env.

# Server
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:5173

# Database: local Postgres via DB_*, or a single DATABASE_URL (e.g. Neon).
# DATABASE_URL takes precedence when set. Neon URLs include ?sslmode=require.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=edulens_lms
DB_USER=postgres
DB_PASSWORD=
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
# DB_SSL=true

# Tests create and drop this database (must end in _test). Defaults to edulens_lms_test.
# TEST_DB_NAME=edulens_lms_test

# Initial super admin created by `npm run migrate`. Required in production;
# development falls back to superadmin@edulens.com / Admin123!
# SUPER_ADMIN_EMAIL=
# SUPER_ADMIN_PASSWORD=

# Auth
JWT_SECRET=change-me
JWT_EXPIRE=7d

# Email (password reset)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
FROM_EMAIL=
FROM_NAME=Edulens LMS

# AI worksheet generation
OPENAI_API_KEY=

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
